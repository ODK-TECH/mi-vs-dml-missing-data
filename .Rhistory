source("R/dgm.R")
source("R/dgm.R")
source("R/dgm.R")
source("R/methods.R")
# Move to the project folder, whichever way the script was started:
# Rscript with a path, RStudio's Source button, or source() with a path.
local({
if (file.exists(file.path("R", "dgm.R"))) return(invisible())
file_arg <- sub("^--file=", "", grep("^--file=", commandArgs(FALSE), value = TRUE))
sourced  <- tryCatch(sys.frame(1)$ofile, error = function(e) NULL)
for (path in c(file_arg, sourced)) {
dir <- dirname(normalizePath(path, mustWork = FALSE))
if (file.exists(file.path(dir, "R", "dgm.R"))) {
setwd(dir)
return(invisible())
}
}
stop("Can't find the project folder (the one that contains R/dgm.R). ",
"In RStudio, choose File > Open Project and pick mi-vs-dml-missing-data.Rproj, ",
"then run the script again. Your current folder is: ", getwd(), call. = FALSE)
})
